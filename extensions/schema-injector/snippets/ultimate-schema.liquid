{% comment %}
  Schema Injector - Ultimate Schema Snippet
  Renders JSON-LD schema markup for a specific schema group.
  Usage: {% render 'ultimate-schema', group: 'your-group-slug' %}
{% endcomment %}

{% assign schema_groups = shop.metafields.schema_injector %}
{% if schema_groups %}
  {% for group in schema_groups %}
    {% assign group_key = group[0] %}
    {% assign group_data = group[1] %}
    
    {% if group_data %}
      {% assign schema_payload = group_data %}
      {% if schema_payload.type == 'json' %}
        {% assign schema_payload = schema_payload.value %}
      {% endif %}

      {% if schema_payload %}
        {% assign g_target_type = schema_payload.targetType %}
        {% assign g_target_page_ids = schema_payload.targetPageIds | split: ',' %}
        {% assign g_target_post_ids = schema_payload.targetPostIds | split: ',' %}
        {% assign matched = false %}

        {% case g_target_type %}
          {% when 'liquid_snippet' or 'all_pages' %}
            {% assign matched = true %}

          {% when 'all_products' %}
            {% if template == 'product' %}
              {% assign matched = true %}
            {% endif %}

          {% when 'all_blogs' %}
            {% if template == 'article' or template == 'blog' %}
              {% assign matched = true %}
            {% endif %}

          {% when 'specific_pages' %}
            {% if template == 'page' %}
              {% for pid in g_target_page_ids %}
                {% if pid == page.id %}
                  {% assign matched = true %}
                  {% break %}
                {% endif %}
              {% endfor %}
            {% endif %}

          {% when 'specific_products' %}
            {% if template == 'product' %}
              {% for pid in g_target_page_ids %}
                {% if pid == product.id %}
                  {% assign matched = true %}
                  {% break %}
                {% endif %}
              {% endfor %}
            {% endif %}

          {% when 'specific_blogs' %}
            {% if template == 'article' or template == 'blog' %}
              {% for pid in g_target_post_ids %}
                {% if pid == article.id or pid == blog.id %}
                  {% assign matched = true %}
                  {% break %}
                {% endif %}
              {% endfor %}
            {% endif %}
        {% endcase %}

        {% if matched %}
          {% for schema_item in schema_payload.schemas %}
            {% if schema_item.json != blank %}
              <script type="application/ld+json">
                {{ schema_item.json }}
              </script>
            {% endif %}
          {% endfor %}
        {% endif %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}